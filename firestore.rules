rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------
    // SECURITY HELPERS
    // ---------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn()
             && request.auth.uid == userId;
    }

    function currentMembership() {
      return get(
        /databases/$(database)/documents/memberships/$(request.auth.uid)
      ).data;
    }

    function hasActiveMembership() {
      return isSignedIn()

             && exists(
               /databases/$(database)/documents/memberships/$(request.auth.uid)
             )

             && currentMembership().status == 'active'

             && currentMembership().validUntil is timestamp

             && currentMembership().validUntil > request.time;
    }

    function privateEvent() {
      return get(
        /databases/$(database)/documents/events/private_event
      ).data;
    }

    // ---------------------------------------------------------
    // USERS
    // ---------------------------------------------------------

    match /users/{userId} {

      allow read: if isOwner(userId);

      allow create: if isOwner(userId)

                    && request.resource.data.keys().hasOnly([
                      'fullName',
                      'email',
                      'phone',
                      'createdAt'
                    ])

                    && request.resource.data.fullName is string

                    && request.resource.data.fullName.size() > 0

                    && request.resource.data.email is string

                    && request.resource.data.email
                       == request.auth.token.email

                    && request.resource.data.phone is string

                    && request.resource.data.createdAt == request.time;

      allow update: if isOwner(userId)

                    && request.resource.data
                        .diff(resource.data)
                        .affectedKeys()
                        .hasOnly([
                          'fullName',
                          'phone',
                          'updatedAt'
                        ])

                    && request.resource.data.fullName is string

                    && request.resource.data.fullName.size() > 0

                    && request.resource.data.phone is string

                    && request.resource.data.email
                       == resource.data.email

                    && request.resource.data.createdAt
                       == resource.data.createdAt

                    && request.resource.data.updatedAt
                       == request.time;

      allow delete: if false;
    }

    // ---------------------------------------------------------
    // NOTIFICATION SETTINGS
    // ---------------------------------------------------------

    match /users/{userId}/settings/notifications {

      allow read: if isOwner(userId);

      allow create: if isOwner(userId)

                    && request.resource.data.keys().hasOnly([
                      'pushNotifications',
                      'emailNotifications',
                      'smsNotifications',
                      'soundAndVibration',
                      'eventReminders',
                      'allowanceAlerts',
                      'promotionsAndOffers',
                      'createdAt',
                      'updatedAt'
                    ])

                    && request.resource.data.pushNotifications is bool
                    && request.resource.data.emailNotifications is bool
                    && request.resource.data.smsNotifications is bool
                    && request.resource.data.soundAndVibration is bool
                    && request.resource.data.eventReminders is bool
                    && request.resource.data.allowanceAlerts is bool
                    && request.resource.data.promotionsAndOffers is bool

                    && request.resource.data.createdAt == request.time
                    && request.resource.data.updatedAt == request.time;

      allow update: if isOwner(userId)

                    && request.resource.data
                        .diff(resource.data)
                        .affectedKeys()
                        .hasOnly([
                          'pushNotifications',
                          'emailNotifications',
                          'smsNotifications',
                          'soundAndVibration',
                          'eventReminders',
                          'allowanceAlerts',
                          'promotionsAndOffers',
                          'updatedAt'
                        ])

                    && request.resource.data.pushNotifications is bool
                    && request.resource.data.emailNotifications is bool
                    && request.resource.data.smsNotifications is bool
                    && request.resource.data.soundAndVibration is bool
                    && request.resource.data.eventReminders is bool
                    && request.resource.data.allowanceAlerts is bool
                    && request.resource.data.promotionsAndOffers is bool

                    && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    // ---------------------------------------------------------
    // NOTIFICATIONS
    // ---------------------------------------------------------

    match /users/{userId}/notifications/{notificationId} {

      allow read: if isOwner(userId);

      allow create: if isOwner(userId)

                    && request.resource.data.keys().hasOnly([
                      'title',
                      'message',
                      'type',
                      'isRead',
                      'hasDetails',
                      'reservationId',
                      'createdAt',
                      'updatedAt'
                    ])

                    && request.resource.data.title
                       == 'Event Reservation Confirmed'

                    && request.resource.data.message
                       == 'Your private event reservation has been confirmed.'

                    && request.resource.data.type == 'event'

                    && request.resource.data.isRead == false

                    && request.resource.data.hasDetails == true

                    && request.resource.data.reservationId is string

                    && notificationId
                       == request.resource.data.reservationId

                    && exists(
                      /databases/$(database)/documents/reservations/$(request.resource.data.reservationId)
                    )

                    && get(
                      /databases/$(database)/documents/reservations/$(request.resource.data.reservationId)
                    ).data.userId == request.auth.uid

                    && request.resource.data.createdAt == request.time

                    && request.resource.data.updatedAt == request.time;

      allow update: if isOwner(userId)

                    && request.resource.data
                        .diff(resource.data)
                        .affectedKeys()
                        .hasOnly([
                          'isRead',
                          'updatedAt'
                        ])

                    && request.resource.data.isRead == true

                    && request.resource.data.updatedAt == request.time;

      allow delete: if isOwner(userId);
    }

    // ---------------------------------------------------------
    // MEMBERSHIPS
    // ---------------------------------------------------------

    match /memberships/{userId} {

      allow read: if isOwner(userId);

      allow create: if isOwner(userId)

                    && request.resource.data.keys().hasOnly([
                      'plan',
                      'status',
                      'memberId',
                      'startedAt',
                      'validUntil',
                      'maxGuests',
                      'createdAt',
                      'updatedAt'
                    ])

                    && request.resource.data.plan in [
                      'Basic',
                      'Premium',
                      'VIP'
                    ]

                    && request.resource.data.status == 'active'

                    && request.resource.data.memberId is string

                    && request.resource.data.memberId.size() > 0

                    && request.resource.data.startedAt is timestamp

                    && request.resource.data.validUntil is timestamp

                    && request.resource.data.startedAt
                       >= request.time - duration.value(5, 'm')

                    && request.resource.data.startedAt
                       <= request.time + duration.value(5, 'm')

                    && request.resource.data.validUntil
                       > request.resource.data.startedAt

                    && request.resource.data.validUntil
                       <= request.resource.data.startedAt
                          + duration.value(366, 'd')

                    && request.resource.data.maxGuests is int

                    && (
                      (
                        request.resource.data.plan == 'Basic'
                        && request.resource.data.maxGuests == 1
                      )
                      ||
                      (
                        request.resource.data.plan == 'Premium'
                        && request.resource.data.maxGuests == 2
                      )
                      ||
                      (
                        request.resource.data.plan == 'VIP'
                        && request.resource.data.maxGuests == 2
                      )
                    )

                    && request.resource.data.createdAt == request.time

                    && request.resource.data.updatedAt == request.time;

      allow update, delete: if false;
    }

    // ---------------------------------------------------------
    // USAGE
    // ---------------------------------------------------------

    match /usage/{userId}/months/{monthId} {

      allow read: if isOwner(userId);

      allow create: if isOwner(userId)

                    && request.resource.data.keys().hasOnly([
                      'hookahUsed',
                      'drinksUsed',
                      'createdAt',
                      'updatedAt'
                    ])

                    && request.resource.data.hookahUsed is int

                    && request.resource.data.hookahUsed == 0

                    && request.resource.data.drinksUsed is int

                    && request.resource.data.drinksUsed == 0

                    && request.resource.data.createdAt == request.time

                    && request.resource.data.updatedAt == request.time;

      allow update, delete: if false;
    }

    // ---------------------------------------------------------
    // EVENTS
    // ---------------------------------------------------------

    match /events/{eventId} {

      allow read: if hasActiveMembership();

      allow create, update, delete: if false;
    }

    // ---------------------------------------------------------
    // RESERVATIONS
    // ---------------------------------------------------------

    match /reservations/{reservationId} {

      allow create: if hasActiveMembership()

                    && exists(
                      /databases/$(database)/documents/events/private_event
                    )

                    && privateEvent().isActive == true

                    && request.resource.data.keys().hasOnly([
                      'userId',
                      'eventId',
                      'eventType',
                      'eventDateTime',
                      'duration',
                      'guestCount',
                      'baseRate',
                      'estimatedTotal',
                      'currency',
                      'status',
                      'createdAt',
                      'updatedAt'
                    ])

                    && request.resource.data.userId
                       == request.auth.uid

                    && request.resource.data.eventId
                       == 'private_event'

                    && request.resource.data.eventType is string

                    && request.resource.data.eventType.size() > 0

                    && request.resource.data.eventType.size() <= 80

                    && request.resource.data.eventDateTime is timestamp

                    && request.resource.data.eventDateTime
                       > request.time

                    && request.resource.data.duration is int

                    && request.resource.data.duration > 0

                    && request.resource.data.duration <= 24

                    && request.resource.data.guestCount is int

                    && request.resource.data.guestCount
                       >= privateEvent().minGuests

                    && request.resource.data.guestCount
                       <= privateEvent().maxGuests

                    && request.resource.data.baseRate is number

                    && request.resource.data.baseRate
                       == privateEvent().baseRate

                    && request.resource.data.estimatedTotal is number

                    && request.resource.data.estimatedTotal
                       == privateEvent().baseRate
                          * request.resource.data.duration

                    && request.resource.data.currency is string

                    && request.resource.data.currency
                       == privateEvent().currency

                    && request.resource.data.status
                       == 'confirmed'

                    && request.resource.data.createdAt
                       == request.time

                    && request.resource.data.updatedAt
                       == request.time;

      allow read: if isOwner(resource.data.userId);

      allow update, delete: if false;
    }

    // ---------------------------------------------------------
    // DOOR ACCESS REQUESTS
    // ---------------------------------------------------------

    match /doorAccessRequests/{requestId} {

      allow create: if hasActiveMembership()

                    && request.resource.data.keys().hasOnly([
                      'userId',
                      'memberId',
                      'membershipPlan',
                      'guestCount',
                      'status',
                      'createdAt',
                      'expiresAt'
                    ])

                    && request.resource.data.userId
                       == request.auth.uid

                    && request.resource.data.memberId is string

                    && request.resource.data.membershipPlan in [
                      'Basic',
                      'Premium',
                      'VIP'
                    ]

                    && request.resource.data.guestCount is int

                    && request.resource.data.guestCount >= 0

                    && request.resource.data.status == 'pending'

                    && request.resource.data.createdAt == request.time

                    && request.resource.data.expiresAt is timestamp

                    && request.resource.data.expiresAt > request.time

                    && request.resource.data.expiresAt
                       <= request.time + duration.value(10, 'm')

                    && request.resource.data.memberId
                       == currentMembership().memberId

                    && request.resource.data.membershipPlan
                       == currentMembership().plan

                    && request.resource.data.guestCount
                       <= currentMembership().maxGuests;

      allow read: if isOwner(resource.data.userId);

      allow update, delete: if false;
    }

    // ---------------------------------------------------------
    // DEFAULT DENY
    // ---------------------------------------------------------

    match /{document=**} {
      allow read, write: if false;
    }
  }
}